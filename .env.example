# --- Telegram ---
# Bot-panel token from @BotFather
BOT_TOKEN=
# my.telegram.org -> API development tools (log in with the SELLING account's number)
TG_API_ID=
TG_API_HASH=
# Your personal Telegram user id (@userinfobot). Only this user can use the bot.
ADMIN_TG_ID=
# @username of the selling account (contact in every listing)
SELLER_USERNAME=

# --- Storage ---
# Railway: reference the Postgres service variable. Local example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seller
# Do NOT set on Railway (default /data = the Volume mount path). Local runs only:
# DATA_DIR=./data

# --- Claude ---
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_MODEL_FAST=claude-haiku-5-5
# AI_WEB_SEARCH_MAX_USES=5

# --- Apify (Bazaraki comparables). Without it pricing uses web research only. ---
APIFY_TOKEN=
# APIFY_BAZARAKI_ACTOR=logiover~bazaraki-scraper
# APIFY_MAX_LISTINGS=30

# --- Userbot (selling account), stage 2 ---
# Generate locally: python scripts/make_session.py  (never share this string)
USERBOT_SESSION=

# --- Publisher limits (defaults are conservative; Cyprus time) ---
# PUBLISH_WINDOW_START=9
# PUBLISH_WINDOW_END=21
# PUBLISH_MAX_PER_HOUR=3
# PUBLISH_MAX_PER_DAY=15
# PUBLISH_GAP_MIN_MINUTES=12
# PUBLISH_GAP_MAX_MINUTES=35
# CHAT_DEFAULT_POSTS_PER_DAY=1

# --- Misc ---
